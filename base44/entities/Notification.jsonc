{
  "name": "Notification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "bet_result",
        "withdrawal",
        "deposit",
        "promotion",
        "security",
        "system",
        "kyc",
        "favorite"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "type",
    "title"
  ]
}